{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListCdrStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aws-detection-response-tfstate-<SUFFIX>"
    },
    {
      "Sid": "ReadWriteCdrState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::aws-detection-response-tfstate-<SUFFIX>/cdr/*"
    }
  ]
}
